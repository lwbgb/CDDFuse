{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"files.exclude": {
			"**/.git": true,
			"**/.svn": true,
			"**/.hg": true,
			"**/.DS_Store": true,
			"**/Thumbs.db": true,
			"**/node_modules": true,
			"**/__pycache__": true
		},
		"commentTranslate.source": "Google",
		"python.testing.unittestEnabled": true,
		// "python.testing.cwd": "${workspaceFolder}/tests", // pytest的工作目录
		// "python.testing.autoTestDiscoverOnSavePattern": "**/tests/**/*.py",
		"python.testing.unittestArgs": [
			"-v",
			"-s",
			"${workspaceFolder}/tests",
			"-p",
			"*test*.py",
		],
	}
}